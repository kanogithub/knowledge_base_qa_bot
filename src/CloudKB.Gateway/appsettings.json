{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "Audience": "cloudkb-api",
    "Issuer": "cloudkb-auth",
    "SecretKey": "a_very_secret_key_used_only_for_cloudkb_bdd_testing_32_bytes_long!"
  },
  "ReverseProxy": {
    "Routes": {
      "chat-route": {
        "ClusterId": "chat-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/chat",
          "Methods": [ "POST" ]
        }
      },
      "index-route": {
        "ClusterId": "indexing-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/index",
          "Methods": [ "POST" ]
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/notifications/stream",
          "Methods": [ "GET" ]
        }
      },
      "notification-logs-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/notifications/logs",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "chat-cluster": {
        "Destinations": {
          "chat-primary": {
            "Address": "http://apiservice-chat"
          }
        }
      },
      "indexing-cluster": {
        "Destinations": {
          "indexing-primary": {
            "Address": "http://apiservice-indexing"
          }
        }
      },
      "notification-cluster": {
        "HttpRequest": {
          "ActivityTimeout": "00:30:00"
        },
        "Destinations": {
          "notification-primary": {
            "Address": "http://apiservice-notification"
          }
        }
      }
    }
  }
}
